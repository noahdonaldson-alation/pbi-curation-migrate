# Copy to .env and fill in. .env is git-ignored — never commit it.

# Alation instance, no trailing slash
ALATION_BASE_URL=https://your-instance.alationcloud.com

# Numeric user ID of the account that owns the refresh token
ALATION_USER_ID=

# Refresh token: Alation UI > profile > Authentication > Create Refresh Token
ALATION_REFRESH_TOKEN=

# Set to false only for a demo tenant with a self-signed cert
ALATION_VERIFY_SSL=true

# Built-in field IDs for title / description. Confirm with `pbi-migrate probe --fields`.
TITLE_FIELD_ID=3
DESCRIPTION_FIELD_ID=4
